# ==========================================
# Root .gitignore for Aegivex AI Monorepo
# ==========================================

# Node.js & Next.js Dependencies & Build Outputs
node_modules/
**/node_modules/
.next/
**/.next/
out/
build/
dist/
.pnp
.pnp.js

# Environment & Secret Files
.env
.env.*
*.env
!.env.example
!backend/.env.example
!frontend/.env.example

# Database & SQLite Files
*.db
*.sqlite
*.sqlite3
aegivex.db

# Python Bytecode & Virtual Environments
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
venv/
env/
.venv/

# Logs & Temporary Files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# System & IDE Files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
