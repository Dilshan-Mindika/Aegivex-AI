# =======================================================
# Aegivex AI Backend Environment Template (.env.example)
# Copy this file to .env and configure your values.
# =======================================================

PROJECT_NAME="Aegivex AI - Web3 Security Copilot"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# JWT Authentication Secret
SECRET_KEY="your_secure_jwt_secret_key_here"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration (Separated for deployment flexiblity)
DB_ENGINE="postgresql"
DB_HOST="localhost"
DB_PORT="5432"
DB_NAME="aegivex_db"
DB_USER="your_db_username"
DB_PASSWORD="your_db_password"

# Optional: Full Connection String override (if provided, takes precedence over individual DB parameters)
# DATABASE_URL="postgresql://your_db_username:your_db_password@localhost:5432/aegivex_db"

# Third-Party API Credentials
OPENAI_API_KEY=""
GROQ_API_KEY=""        # Get 100% Free ultra-fast Llama 3 API key at: https://console.groq.com/keys
OPENROUTER_API_KEY=""  # Get Free access to 30+ open LLMs at: https://openrouter.ai/keys
AI_PROVIDER="auto"     # Options: 'auto', 'groq', 'openrouter', 'openai', 'heuristic'
ETHERSCAN_API_KEY="your_etherscan_api_key_here"
